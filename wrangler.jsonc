{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leaflet",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "LeafletContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "LeafletContainer",
        "name": "LEAFLET_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["LeafletContainer"],
      "tag": "v1"
    }
  ]
}
