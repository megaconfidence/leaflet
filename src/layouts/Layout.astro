---
import { getUserFromContext } from '../lib/astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const user = getUserFromContext(Astro);
const siteTitle = title ? `${title} — Leaflet` : 'Leaflet';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍃</text></svg>" />
    <style is:global>
      :root {
        --bg: #faf9f7;
        --surface: #ffffff;
        --text: #1a1a1a;
        --text-muted: #6b6b6b;
        --border: #e5e3e0;
        --primary: #2d6a4f;
        --primary-hover: #1b4332;
        --danger: #c1432f;
        --radius: 8px;
        --font-serif: Georgia, 'Times New Roman', serif;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
      }

      a { color: var(--primary); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 24px;
      }

      nav {
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }
      nav .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
      }
      nav .brand {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        font-weight: bold;
        color: var(--text);
      }
      nav .brand:hover { text-decoration: none; }
      nav .links { display: flex; gap: 20px; align-items: center; }
      nav .links a { color: var(--text-muted); font-size: 0.9rem; }
      nav .links a:hover { color: var(--text); }
      nav .user-badge {
        font-size: 0.85rem;
        color: var(--text-muted);
        padding: 4px 12px;
        background: var(--bg);
        border-radius: 20px;
      }

      main { padding: 40px 0 80px; }

      h1, h2, h3 { font-family: var(--font-serif); line-height: 1.3; }
      h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
      h2 { font-size: 1.5rem; margin-bottom: 0.4rem; }

      .post-meta {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
      }

      .post-content {
        font-size: 1.05rem;
        line-height: 1.8;
        white-space: pre-wrap;
      }

      .post-card {
        padding: 24px 0;
        border-bottom: 1px solid var(--border);
      }
      .post-card:last-child { border-bottom: none; }
      .post-card h2 { margin-bottom: 0.3rem; }
      .post-card h2 a { color: var(--text); }
      .post-card h2 a:hover { color: var(--primary); }
      .post-card .excerpt {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-top: 0.4rem;
      }

      .badge {
        display: inline-block;
        font-size: 0.75rem;
        padding: 2px 10px;
        border-radius: 20px;
        font-weight: 500;
      }
      .badge-draft { background: #f3f0eb; color: #8a7a5c; }
      .badge-published { background: #e8f5e9; color: #2d6a4f; }

      input[type="text"], input[type="text"], textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-size: 1rem;
        font-family: var(--font-sans);
        background: var(--surface);
        color: var(--text);
      }
      textarea { resize: vertical; min-height: 200px; line-height: 1.6; }
      input:focus, textarea:focus { outline: none; border-color: var(--primary); }
      input[name="title"] { font-family: var(--font-serif); font-size: 1.2rem; }

      button, .btn {
        display: inline-block;
        padding: 8px 20px;
        border: none;
        border-radius: var(--radius);
        font-size: 0.9rem;
        font-family: var(--font-sans);
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s;
      }
      button.primary, .btn.primary {
        background: var(--primary);
        color: white;
      }
      button.primary:hover, .btn.primary:hover {
        background: var(--primary-hover);
        text-decoration: none;
      }
      button.secondary, .btn.secondary {
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
      }
      button.secondary:hover, .btn.secondary:hover {
        background: var(--border);
        text-decoration: none;
      }
      button.danger, .btn.danger {
        background: transparent;
        color: var(--danger);
        border: 1px solid var(--border);
      }
      button.danger:hover, .btn.danger:hover {
        background: var(--danger);
        color: white;
        border-color: var(--danger);
      }

      .form-group { margin-bottom: 20px; }
      .form-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 6px;
        color: var(--text-muted);
      }
      .form-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 24px;
      }

      .alert {
        padding: 12px 16px;
        border-radius: var(--radius);
        margin-bottom: 20px;
        font-size: 0.9rem;
      }
      .alert-error { background: #fef2f2; color: #991b1b; }
      .alert-success { background: #f0fdf4; color: #166534; }

      .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--text-muted);
      }
      .empty-state a { font-weight: 500; }

      .comment {
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
      }
      .comment:last-child { border-bottom: none; }
      .comment .comment-meta {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 4px;
      }
      .comment .comment-meta strong { color: var(--text); }
      .comment .comment-body { font-size: 0.95rem; }

      .section-title {
        font-size: 1.2rem;
        margin: 40px 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
      }

      .dashboard-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
      }

      footer {
        text-align: center;
        padding: 24px;
        color: var(--text-muted);
        font-size: 0.8rem;
        border-top: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <nav>
      <div class="container">
        <a href="/" class="brand">🍃 Leaflet</a>
        <div class="links">
          <a href="/">Home</a>
          {user ? (
            <>
              <a href="/dashboard">Dashboard</a>
              <span class="user-badge">{user.username}</span>
              <form method="POST" action="/api/logout" style="display:inline">
                <button type="submit" class="secondary" style="padding:4px 14px;font-size:0.85rem">Logout</button>
              </form>
            </>
          ) : (
            <a href="/login">Login</a>
          )}
        </div>
      </div>
    </nav>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer>
      <div class="container">Leaflet — a simple blog</div>
    </footer>
  </body>
</html>
