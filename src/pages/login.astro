---
import Layout from '../layouts/Layout.astro';
import { getUserFromContext } from '../lib/astro';

const user = getUserFromContext(Astro);
const error = Astro.url.searchParams.get('error');

if (user) {
  return Astro.redirect('/dashboard');
}

const errorMessages: Record<string, string> = {
  username_required: 'Please enter a username.',
  username_too_long: 'Username must be 50 characters or fewer.',
  auth_required: 'Please log in to continue.',
};
---

<Layout title="Login">
  <h1>Welcome</h1>
  <p style="color: var(--text-muted); margin-bottom: 32px;">Enter a username to start writing.</p>

  {error && <div class="alert alert-error">{errorMessages[error] || 'Something went wrong.'}</div>}

  <form method="POST" action="/api/login">
    <div class="form-group">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" placeholder="Pick any name" autocomplete="off" autofocus required />
    </div>
    <div class="form-actions">
      <button type="submit" class="primary">Continue</button>
    </div>
  </form>
</Layout>
