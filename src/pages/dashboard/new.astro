---
import Layout from '../../layouts/Layout.astro';
import { getUserFromContext } from '../../lib/astro';

const user = getUserFromContext(Astro);

if (!user) {
  return Astro.redirect('/login?error=auth_required');
}

const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  missing_fields: 'Title and content are required.',
};
---

<Layout title="New Post">
  <h1>New Post</h1>

  {error && <div class="alert alert-error">{errorMessages[error] || 'Something went wrong.'}</div>}

  <form method="POST" action="/api/posts">
    <div class="form-group">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" placeholder="Give your post a title" autofocus required />
    </div>
    <div class="form-group">
      <label for="content">Content</label>
      <textarea id="content" name="content" placeholder="Start writing..." required></textarea>
    </div>
    <div class="form-actions">
      <button type="submit" class="primary">Save Draft</button>
      <a href="/dashboard" class="btn secondary">Cancel</a>
    </div>
  </form>
</Layout>
